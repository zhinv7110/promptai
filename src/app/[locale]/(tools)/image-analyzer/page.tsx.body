
import { useState, useCallback, useRef } from 'react';
import { useParams } from 'next/navigation';
import {
  Upload, ImageIcon, Copy, Check, ScanEye, Palette,
  Camera, Lightbulb, X, Loader2, Wand2,
} from 'lucide-react';
import { analyzeImage, type ImageAnalysis } from '@/lib/image-analyzer';

export default function ImageAnalyzerPage() {
  const { locale } = useParams<{ locale: string }>();
  const isZh = locale === 'zh';
  const fileRef = useRef<HTMLInputElement>(null);

  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState<string | null>(null);
  const [analyzing, setAnalyzing] = useState(false);
  const [analysis, setAnalysis] = useState<ImageAnalysis | null>(null);
  const [error, setError] = useState('');
  const [copied, setCopied] = useState('');

  const handleFile = useCallback((f: File | null) => {
    if (!f) return;
    if (!f.type.startsWith('image/')) {
      setError(isZh ? '请选择图片文件' : 'Please select an image file');
      return;
    }
    setError('');
    setFile(f);
    setAnalysis(null);
    const reader = new FileReader();
    reader.onload = (e) => setPreview(e.target?.result as string);
    reader.readAsDataURL(f);
  }, [isZh]);

  const handleDrop = useCallback((e: React.DragEvent) => {
    e.preventDefault();
    handleFile(e.dataTransfer.files[0] || null);
  }, [handleFile]);

  const handleAnalyze = useCallback(async () => {
    if (!file) return;
    setAnalyzing(true);
    setError('');
    try {
      const result = await analyzeImage(file);
      setAnalysis(result);
    } catch {
      setError(isZh ? '分析失败，请重试' : 'Analysis failed, please try again');
    } finally {
      setAnalyzing(false);
    }
  }, [file, isZh]);

  const copyText = (text: string, label: string) => {
    navigator.clipboard.writeText(text);
    setCopied(label);
    setTimeout(() => setCopied(''), 2000);
  };

  return (
    <div className="max-w-5xl mx-auto">
      {/* Header */}
      <div className="flex items-center gap-4 mb-8">
        <div className="inline-flex rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 p-3.5 text-white shadow-lg shadow-amber-500/25">
          <ScanEye className="h-6 w-6" />
        </div>
        <div>
          <h1 className="text-2xl font-bold text-zinc-900 dark:text-zinc-50">
            {isZh ? '图像分析器' : 'Image Analyzer'}
          </h1>
          <p className="text-zinc-500 dark:text-zinc-400">
            {isZh ? '上传图片，分析色彩、构图并生成相关提示词' : 'Upload an image, analyze colors & composition, get prompt suggestions'}
          </p>
        </div>
      </div>

      <div className="grid gap-6 lg:grid-cols-5">
        {/* Upload Panel */}
        <div className="lg:col-span-2 space-y-4">
          <input
            ref={fileRef}
            type="file"
            accept="image/*"
            className="hidden"
            onChange={(e) => handleFile(e.target.files?.[0] || null)}
          />

          <div
            onDrop={handleDrop}
            onDragOver={(e) => e.preventDefault()}
            onClick={() => fileRef.current?.click()}
            className={`relative rounded-2xl border-2 border-dashed p-8 text-center cursor-pointer transition-all ${
              preview
                ? 'border-zinc-200 dark:border-zinc-800'
                : 'border-zinc-300 dark:border-zinc-700 hover:border-amber-400 dark:hover:border-amber-600 hover:bg-amber-50/50 dark:hover:bg-amber-950/20'
            }`}
          >
            {preview ? (
              <div className="relative group">
                <img
                  src={preview}
                  alt="Preview"
                  className="mx-auto max-h-64 rounded-xl object-contain"
                />
                <button
                  onClick={(e) => { e.stopPropagation(); setFile(null); setPreview(null); setAnalysis(null); }}
                  className="absolute top-2 right-2 p-1.5 rounded-full bg-black/50 text-white opacity-0 group-hover:opacity-100 transition-opacity"
                >
                  <X className="h-4 w-4" />
                </button>
              </div>
            ) : (
              <>
                <Upload className="mx-auto h-10 w-10 text-zinc-400" />
                <p className="mt-3 text-sm font-medium text-zinc-600 dark:text-zinc-400">
                  {isZh ? '点击或拖拽上传图片' : 'Click or drag to upload'}
                </p>
                <p className="mt-1 text-xs text-zinc-400">
                  PNG, JPG, WebP
                </p>
              </>
            )}
          </div>

          <button
            onClick={handleAnalyze}
            disabled={!file || analyzing}
            className="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-amber-500/25 hover:shadow-xl hover:from-amber-400 hover:to-orange-500 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {analyzing ? (
              <Loader2 className="h-4 w-4 animate-spin" />
            ) : (
              <ScanEye className="h-4 w-4" />
            )}
            {analyzing
              ? (isZh ? '分析中...' : 'Analyzing...')
              : (isZh ? '分析图片' : 'Analyze Image')}
          </button>

          {error && (
            <p className="text-sm text-red-500 text-center">{error}</p>
          )}
        </div>

        {/* Results Panel */}
        <div className="lg:col-span-3 space-y-4">
          {analyzing ? (
            <div className="rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xl p-12 text-center">
              <Loader2 className="mx-auto h-8 w-8 animate-spin text-amber-500" />
              <p className="mt-4 text-sm text-zinc-500">
                {isZh ? '正在分析图片颜色和构图...' : 'Analyzing image colors and composition...'}
              </p>
            </div>
          ) : analysis ? (
            <>
              {/* Color Palette */}
              <div className="rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xl p-5 shadow-sm">
                <div className="flex items-center gap-2 mb-4">
                  <Palette className="h-4 w-4 text-amber-500" />
                  <h3 className="text-sm font-semibold text-zinc-700 dark:text-zinc-300">
                    {isZh ? '色彩分析' : 'Color Palette'}
                  </h3>
                  <span className="text-xs text-zinc-400">· {analysis.palette.mood}</span>
                  <span className="text-xs text-zinc-400">· {analysis.palette.temperature}</span>
                </div>
                <div className="flex items-center gap-2 flex-wrap">
                  {[analysis.palette.dominant, ...analysis.palette.secondary].map((color, i) => (
                    <div key={i} className="flex items-center gap-2">
                      <div
                        className="h-8 w-8 rounded-lg ring-2 ring-offset-1 ring-zinc-200 dark:ring-zinc-700 shadow-sm"
                        style={{ backgroundColor: color }}
                      />
                      <span className="text-xs font-mono text-zinc-500">{color}</span>
                    </div>
                  ))}
                </div>
              </div>

              {/* Composition */}
              <div className="rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xl p-5 shadow-sm">
                <div className="flex items-center gap-2 mb-2">
                  <Camera className="h-4 w-4 text-amber-500" />
                  <h3 className="text-sm font-semibold text-zinc-700 dark:text-zinc-300">
                    {isZh ? '构图' : 'Composition'}
                  </h3>
                </div>
                <p className="text-sm text-zinc-600 dark:text-zinc-400 capitalize">
                  {analysis.composition}
                </p>
              </div>

              {/* Suggestions */}
              <div className="grid gap-3 sm:grid-cols-2">
                <div className="rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xl p-4 shadow-sm">
                  <div className="flex items-center gap-2 mb-3">
                    <Wand2 className="h-4 w-4 text-amber-500" />
                    <h3 className="text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                      {isZh ? '推荐风格' : 'Suggested Styles'}
                    </h3>
                  </div>
                  <div className="flex flex-wrap gap-1.5">
                    {analysis.suggestedStyles.map((s) => (
                      <span key={s} className="px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400">
                        {s}
                      </span>
                    ))}
                  </div>
                </div>

                <div className="rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xl p-4 shadow-sm">
                  <div className="flex items-center gap-2 mb-3">
                    <Lightbulb className="h-4 w-4 text-amber-500" />
                    <h3 className="text-xs font-semibold text-zinc-500 uppercase tracking-wider">
                      {isZh ? '推荐灯光' : 'Suggested Lighting'}
                    </h3>
                  </div>
                  <div className="flex flex-wrap gap-1.5">
                    {analysis.suggestedLighting.map((l) => (
                      <span key={l} className="px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400">
                        {l}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              {/* Generated Prompts */}
              <div className="rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xl p-5 shadow-sm">
                <h3 className="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-3">
                  {isZh ? '相关提示词建议' : 'Suggested Prompts'}
                </h3>
                <div className="space-y-2">
                  {analysis.generatedPrompts.map((prompt, i) => (
                    <div
                      key={i}
                      className="flex items-start justify-between gap-3 rounded-xl bg-zinc-50 dark:bg-zinc-800/50 p-3 group hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
                    >
                      <p className="text-sm text-zinc-700 dark:text-zinc-300 font-mono leading-relaxed flex-1">
                        {prompt}
                      </p>
                      <button
                        onClick={() => copyText(prompt, `ap-${i}`)}
                        className="shrink-0 p-1.5 rounded-lg text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300 opacity-0 group-hover:opacity-100 transition-all"
                      >
                        {copied === `ap-${i}` ? <Check className="h-4 w-4 text-green-500" /> : <Copy className="h-4 w-4" />}
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            </>
          ) : (
            <div className="rounded-2xl border border-dashed border-zinc-300 dark:border-zinc-700 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-xl p-12 text-center">
              <ImageIcon className="mx-auto h-10 w-10 text-zinc-300 dark:text-zinc-600" />
              <p className="mt-4 text-sm text-zinc-400 dark:text-zinc-500">
                {isZh ? '上传图片后点击分析，获取色彩和构图分析' : 'Upload an image and click analyze to get insights'}
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
